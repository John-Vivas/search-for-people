# ============================================================
# Estamos Buscando — Environment Variables Template
# ============================================================
# Copy this file to .env or .env.local and fill in your values.
# NEVER commit real credentials or secrets to Git.

# --- Supabase Configuration ---
# Public anon / publishable key safe for browser client use with RLS enabled
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Cloudinary Configuration ---
# Unsigned upload preset for browser-side image optimization
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# --- Feature flags ---
# Tablero de "Ayuda" (coordinación de recursos). En desarrollo: déjalo en
# false para ocultarlo (nav, CTA de inicio y ruta /ayuda). Ponlo en true
# para activarlo. Requiere reconstruir tras cambiarlo (las VITE_* se hornean
# en el build).
VITE_ENABLE_AID=false

# --- Panel de moderación ---
# Clave simple para entrar al panel (/admin) y a "Gestión de casos". Si se deja
# vacía, el panel queda abierto (como hoy). Protección provisional hasta el login
# real. Recuerda reconstruir tras cambiarla (las VITE_* se hornean en el build).
VITE_ADMIN_PIN=
