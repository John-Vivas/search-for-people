# ============================================================
# Estamos Buscando — Environment Variables Template
# ============================================================
# Copy this file to .env or .env.local and fill in your values.
# NEVER commit real credentials or secrets to Git.

# --- Supabase Configuration ---
# Public anon / publishable key safe for browser client use with RLS enabled
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Cloudinary Configuration ---
# Unsigned upload preset for browser-side image optimization
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
